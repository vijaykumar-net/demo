        )

    # --------------------------------------------------------
    # Download Haar Cascade XML
    # --------------------------------------------------------

    cascade_path = "/content/haarcascade_frontalface_default.xml"

    cascade_url = (
        "https://raw.githubusercontent.com/opencv/opencv/4.x/"
        "data/haarcascades/haarcascade_frontalface_default.xml"
    )

    if (
        not os.path.exists(cascade_path)
        or os.path.getsize(cascade_path) < 1000
    ):
        print("Downloading Haar Cascade XML...")
        urllib.request.urlretrieve(cascade_url, cascade_path)

    face_cascade = cv2.CascadeClassifier(cascade_path)

    if face_cascade.empty():
        raise RuntimeError(
            "Could not load Haar Cascade XML. "
            "Check the downloaded file and internet connection."
        )

    print("Haar Cascade loaded successfully.")

    # --------------------------------------------------------
    # Process captured webcam image
    # --------------------------------------------------------

    def capture_webcam_image(data_url):
        try:
            image_data = data_url.split(",", 1)[1]
            image_bytes = base64.b64decode(image_data)

            # Pillow provides an RGB image
            rgb_image = np.array(
                Image.open(io.BytesIO(image_bytes)).convert("RGB")
            )

            # Convert RGB to BGR for OpenCV
            frame = cv2.cvtColor(rgb_image, cv2.COLOR_RGB2BGR)

            gray = cv2.cvtColor(frame, cv2.COLOR_BGR2GRAY)

            faces = face_cascade.detectMultiScale(
                gray,
                scaleFactor=1.1,
                minNeighbors=5,
                minSize=(30, 30)
            )

            print("Number of faces detected:", len(faces))

            for (x, y, w, h) in faces:
                cv2.rectangle(
                    frame,
                    (x, y),
                    (x + w, y + h),
                    (0, 255, 0),
                    2
                )

            cv2_imshow(frame)

        except Exception as error:
            print("Face detection error:", repr(error))

    # Register callback for the browser webcam
    output.register_callback(
        "notebook.capture_webcam_image",
        capture_webcam_image
    )

