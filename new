import sys
import subprocess
import importlib.metadata as metadata

OPENCV_VERSION = "4.14.0.94"

OPENCV_PACKAGES = [
    "opencv-python",
    "opencv-contrib-python",
    "opencv-python-headless",
    "opencv-contrib-python-headless",
]


def setup_opencv():
    # Check all installed OpenCV package variants
    installed = {}

    for package in OPENCV_PACKAGES:
        try:
            installed[package] = metadata.version(package)
        except metadata.PackageNotFoundError:
            pass

    correct_install = (
        installed == {"opencv-python-headless": OPENCV_VERSION}
    )

    # If OpenCV was already imported, check whether the old module
    # is still loaded in the current Python runtime.
    import sys

    loaded_cv2 = sys.modules.get("cv2")
    loaded_version = (
        getattr(loaded_cv2, "__version__", "")
        if loaded_cv2 is not None
        else ""
    )

    if correct_install:
        if loaded_version and not loaded_version.startswith("4.14.0"):
            print("OpenCV 4.x is installed, but the old cv2 module is loaded.")
            print("Restart Runtime → Restart session, then rerun this cell.")
            return False

        print("Compatible OpenCV version is already installed.")
        return True

    print("Removing conflicting OpenCV packages...")

    subprocess.run(
        [
            sys.executable, "-m", "pip", "uninstall", "-y",
            *OPENCV_PACKAGES
        ],
        check=True
    )

    print("Installing OpenCV", OPENCV_VERSION, "...")

    subprocess.run(
        [
            sys.executable, "-m", "pip", "install",
            "--no-deps",
            f"opencv-python-headless=={OPENCV_VERSION}"
        ],
        check=True
    )

    print("\nOpenCV installation completed.")
    print("NOW select Runtime → Restart session.")
    print("Then rerun this SAME cell to start face detection.")

    return False


